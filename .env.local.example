# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API). The service role key stays server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for debates: Claude judges and argues, AssemblyAI transcribes.
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=

# "true" opens the app. Unset shows only the landing page and waitlist.
NEXT_PUBLIC_AUTH_LIVE=true

# Bearer token the two crons in vercel.json require. Any long random string.
CRON_SECRET=

# Optional: live ranked debates over video (dashboard.daily.co > Developers).
DAILY_API_KEY=

# Optional: payments. Use test keys locally. scripts/stripe-setup.mjs prints the coupon id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_COUPON_ID=

# Optional: your own PostHog project key (phc_...). Empty = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
